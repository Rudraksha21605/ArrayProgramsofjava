import java.util.*;
public class Prime {
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        boolean x=prime(n);
        System.out.println(x);
    }
    public static boolean prime(int n){
        if(n<=1){
            return false;
        }
        for(int i=2;i*i<n;i++){
            if(n%i==0){
                return false;
            }
        }
        return true;
    }
}
