import java.util.*;
class MinimumLength{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int[] arr=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int target=sc.nextInt();
        int x=minimum(arr,target);
        System.out.println(x);
    }
    public static int minimum(int [] arr,int target){
        int n=arr.length;
        int min=Integer.MAX_VALUE;
        int sum=0;
        int right=0;
        int left=0;
        while(right<n){
            sum=sum+arr[right];
            while(sum>=target){
                sum=sum-arr[left];
                min=Math.min(min,right-left+1);
                left=left+1;
            }
            right++;
        }
        return min;
    }
}


