import java.util.*;
class MaximumAverageSubarray{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int[] arr=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int k=sc.nextInt();
        double x=average(arr,k);
        System.out.printf("%.5f%n",x);
    }
    public static double average(int [] arr, int k){
        int n=arr.length;
        double maxsum=0;
        for(int i=0;i<k;i++){
            maxsum=maxsum+arr[i];
        }
        double avgsum=maxsum/k;
        double windowsum=maxsum;
        for(int j=k;j<n;j++){
            windowsum=windowsum+arr[j]-arr[j-k];
            double avg=windowsum/k;
            avgsum=Math.max(avg,avgsum);
        }
        return avgsum;
    }
}

       
