class Solution {
    public int[] countOddEven(int[] arr) {
        // Code here
        int[] arr1=new int[2];
        int even=0;
        int odd=0;
        for(int i=0;i<arr.length;i++){
            if(arr[i]%2==0){
                even++;
            }
            else{
                odd++;
            }
        }
        arr1[0]=odd;
        arr1[1]=even;
        return arr1;
    }
}
