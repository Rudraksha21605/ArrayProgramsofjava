import java.util.*;

public class Sliding {
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int[] arr=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int k=sc.nextInt();
        int x=slide(arr,k);
        System.out.println(x);
    }
    public static int slide(int[]arr,int k){
        int n=arr.length;
        int count=0;
        for(int i=0;i<n;i++){
            int sum=0;
            for(int j=i;j<n;j++){
                if(sum+arr[j]<=k){
                    sum=sum+arr[j];
                    count++;
                }
                else{
                    break;
                }
            }
        }
        return count;
    }
}
          
