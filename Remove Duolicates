class Solution {
    public boolean containsNearbyDuplicate(int[] nums, int k) {
        Set<Integer>ans=new HashSet<>();
        int left=0;
        for(int i=0;i<nums.length;i++){
            if(ans.contains(nums[i])){
                return true;
            }
            ans.add(nums[i]);
            if(i-left>=k){
                ans.remove(nums[left]);
                left++;
            }
        }
        return false;
    }
}
          
