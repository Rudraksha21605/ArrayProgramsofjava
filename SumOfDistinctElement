class Solution {
    int findSum(int[] arr) {
        int sum=0;
        // code here
        HashSet<Integer>ans=new HashSet<>();
        for(int i=0;i<arr.length;i++){
            if(!ans.contains(arr[i])){
                sum=sum+arr[i];
                ans.add(arr[i]);
            }
        }
        return sum;
    }
}
            
      
