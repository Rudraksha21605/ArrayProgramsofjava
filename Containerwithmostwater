class Solution {
    public int maxArea(int[] height) {
        int max=0;
        int l=0;
        int br=1;
        int i=0;
        int j=height.length-1;
        while(i<=j){
            int ar=1;
            l=j-i;
            if(height[i]<height[j]){
                br=height[i];
                ar=l*br;
                i++;
            }
            else if(height[i]>=height[j]){
                br=height[j];
                ar=l*br;
                j--;
            }
            if(ar>=max){
                max=ar;
            }
        }
        return max;
    }
}
              
  
